# Application root, not the home.xhtml page or the ~~chain endpoint.
SCENARI_URL=http://127.0.0.1:18080/scenari
SCENARI_USERNAME=superadmin
SCENARI_PASSWORD=replace-with-your-password
# Official script API frame; use web only if required by the server configuration.
SCENARI_EXEC_FRAME=script
SCENARI_TIMEOUT_SECONDS=20
SCENARI_MAX_ITEM_BYTES=2097152
# Opt in to creation and complete-item replacement. Discovery/preview work without writes.
SCENARI_ENABLE_WRITES=false
